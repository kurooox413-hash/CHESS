{
  "manifest_version": 3,
  "name": "Chess Coach — Post-Game Analysis & Study",
  "version": "1.0.0",
  "description": "Review finished games with a built-in chess engine and an AI coach. Fair play: disabled during live games.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://api.chess.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Chess Coach" },
  "side_panel": { "default_path": "index.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["guard.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
